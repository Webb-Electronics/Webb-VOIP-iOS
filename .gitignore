Pods/
Podfile.lock

WebbCompanion.xcworkspace/

# DS files
.DS_Store
._.DS_Store
**/.DS_Store
**/._.DS_Store

# ---------------------------------------------------------------------------
# Deployment-specific and sensitive material -- must never be published.
# ---------------------------------------------------------------------------

# Site-specific build settings (team ID, push endpoint, PBX domains, STUN).
# Template lives in Config/Deployment.local.xcconfig.example.
Config/Deployment.local.xcconfig

# Signing keys, certificates and provisioning profiles in any form.
VoipServiceCerts/
*.p12
*.pfx
*.pem
*.cer
*.crt
*.key
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# App Store Connect / notarisation credentials
AuthKey_*.p8
ExportOptions.plist
fastlane/report.xml
fastlane/Preview.html
fastlane/.env*

# Stray editor/session leftovers
.git.save
