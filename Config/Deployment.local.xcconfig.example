// ---------------------------------------------------------------------------
// Local deployment configuration (template)
//
// Copy this file to `Deployment.local.xcconfig` and fill in your own values.
// `Deployment.local.xcconfig` is git-ignored on purpose: it holds site-
// specific infrastructure details and account identifiers that must not be
// published alongside the source.
//
//     cp Config/Deployment.local.xcconfig.example Config/Deployment.local.xcconfig
//
// Every setting is optional. Anything left blank keeps the neutral default
// from Deployment.xcconfig, which disables the corresponding behaviour.
//
// Reminder: `//` starts a comment in xcconfig files, so endpoints are given
// as host + path with no `https://` prefix.
// ---------------------------------------------------------------------------

WEBB_DEVELOPMENT_TEAM = ABCDE12345

WEBB_PUSH_REGISTRATION_ENDPOINT = push.example.com/v1/call

WEBB_PUSH_ALLOWED_DOMAINS = pbx.example.com

WEBB_DOMAIN_ALIASES = 10.0.0.1=pbx.example.com,203.0.113.10=pbx.example.com

WEBB_NAT_STUN_POLICIES = pbx.example.com=stun.l.google.com
